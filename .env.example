# Example Environment Variables
# Copy this to .env and fill in your values (NEVER commit .env file!)

# AWS Credentials (for optional LLM mode)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_BEDROCK_ENABLED=true

# Note: The application works without these (uses rule-based mode by default)
